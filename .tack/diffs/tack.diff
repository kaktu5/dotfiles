+fn is_pin_group(table: &dyn TableLike) -> bool {
+    !table.is_empty()
+        && !table.contains_key("url")
+        && table.iter().all(|(_, item)| item.is_table_like())
+        && table.iter().any(|(_, item)| item.get("url").is_some())
